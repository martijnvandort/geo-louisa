# Mapbox GL basemap. Leave blank to use the free Carto / OSM dark basemap.
# The game does not require a Mapbox Studio style.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase Realtime for two-player rooms. Leave both blank to play solo only.
# Use the project URL and the publishable key (or the legacy anon key).
# Never put the secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias accepted by the client if you prefer the new key name.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
